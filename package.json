{
  "dependencies": {
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^12.10.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.9",
    "concurrently": "^10.0.3",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2",
    "vitest": "^4.1.9"
  },
  "scripts": {
    "dev": "concurrently \"nodemon server/index.js\" \"cd client && npm run dev\"",
    "server": "nodemon server/index.js",
    "backup": "node server/backup.js",
    "client": "cd client && npm run dev",
    "test": "npm run test:server && npm run test:client",
    "test:server": "vitest run",
    "test:server:watch": "vitest",
    "test:server:coverage": "vitest run --coverage",
    "test:client": "cd client && npm test",
    "test:client:coverage": "cd client && npm run test:coverage"
  }
}
